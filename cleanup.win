@echo off
REM Cleanup script for sd2R package (Windows)
REM Removes compiled objects, shared libraries, and generated files

REM Recurse: sources live in src\ and several src\sd\* subdirectories
REM (sd, thirdparty, tokenizers, tokenizers\vocab, ...), so a fixed list of
REM directories goes stale whenever a new subdir is added. /R walks the tree.
for /R src %%f in (*.o *.so *.dll *.dylib) do @del /Q "%%f" 2>NUL

REM Remove generated files created by configure
del /Q src\Makevars 2>NUL
del /Q src\Makevars.win 2>NUL
