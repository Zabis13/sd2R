CXX_STD = CXX17

# Enable C99 format specifiers (%zu, %zd) on MinGW
PKG_CPPFLAGS_WIN = -D__USE_MINGW_ANSI_STDIO=1

# All paths and flags resolved by configure.win (no $(shell) calls)
GGMLR_LIB = @GGMLR_LIB@
GGMLR_INCLUDE = @GGMLR_INCLUDE@
VULKAN_CPPFLAGS = @VULKAN_CPPFLAGS@
VULKAN_LIBS = @VULKAN_LIBS@
META_CPPFLAGS = @META_CPPFLAGS@
OPENMP_CXXFLAGS = @OPENMP_CXXFLAGS@
# -DGGML_USE_OPENMP when OpenMP is available (resolved by configure.win).
# Required so the ggml-cpu graph executor's OpenMP regions are compiled in;
# without it the CPU path is single-threaded even with -fopenmp.
OPENMP_CPPFLAGS = @OPENMP_CPPFLAGS@

PKG_CPPFLAGS = -Isd -Isd/core -Isd/thirdparty -Isd/tokenizers -Isd/tokenizers/vocab \
  -DGGML_USE_CPU -D_GNU_SOURCE \
  -DGGML_R_PACKAGE \
  -DSD_USE_UPSTREAM_GGML \
  $(OPENMP_CPPFLAGS) \
  $(VULKAN_CPPFLAGS) \
  $(META_CPPFLAGS) \
  $(PKG_CPPFLAGS_WIN)
PKG_CXXFLAGS = $(OPENMP_CXXFLAGS)
# -L is double-quoted as a belt-and-suspenders guard: configure.win already
# converts GGMLR_LIB to a short 8.3 path (no spaces), but if Windows 8.3 name
# generation is disabled the path may still contain spaces. The quotes keep ld
# from splitting "C:/Program Files/..." into two arguments in that case.
# -static-libstdc++ -static-libgcc: must match ggmlR's Makevars.win.in. sd2R links
# libggml.a (-lggml) statically; if sd2R and that code link a DIFFERENT libstdc++
# than each other (or than the Vulkan ICD), operator new/delete cross a heap
# boundary and crash ~50/50 during Flux2 load (ggml_backend_buffer_init). Static
# C++ runtime gives the final sd2R.dll one libstdc++ for all linked-in objects.
PKG_LIBS = -L"$(GGMLR_LIB)" -lggml $(OPENMP_CXXFLAGS) $(VULKAN_LIBS) -lpthread -lm -static-libstdc++ -static-libgcc

SD_CXX_OBJECTS = \
  sd/conditioning/wan_audio.o \
  sd/convert.o \
  sd/core/backend_fit.o \
  sd/core/compute_workspace.o \
  sd/core/ggml_extend_backend.o \
  sd/core/ggml_extend.o \
  sd/core/ggml_graph_cut.o \
  sd/core/ggml_runner.o \
  sd/core/ggml_tensor_utils.o \
  sd/core/layer_split_partition.o \
  sd/core/parallel.o \
  sd/core/probe/backend_probe.o \
  sd/core/probe/conv_direct.o \
  sd/core/probe/flash_attn.o \
  sd/core/regex.o \
  sd/core/runner_cache.o \
  sd/core/segment_graph_bindings.o \
  sd/core/segment_weight_pipeline.o \
  sd/core/util.o \
  sd/detailer.o \
  sd/extensions/photomaker_extension.o \
  sd/extensions/pulid_extension.o \
  sd/model/adapter/lora_ops.o \
  sd/model_io/gguf_io.o \
  sd/model_io/pickle_io.o \
  sd/model_io/safetensors_io.o \
  sd/model_io/torch_legacy_io.o \
  sd/model_io/torch_zip_io.o \
  sd/model_loader_files.o \
  sd/model_loader.o \
  sd/model_manager_files.o \
  sd/model_manager.o \
  sd/model_manager_prefetch.o \
  sd/name_conversion.o \
  sd/pipeline/diffusion_engine.o \
  sd/pipeline/image.o \
  sd/pipeline/model_builders.o \
  sd/pipeline/request.o \
  sd/pipeline/video.o \
  sd/runtime/audio_processing.o \
  sd/runtime/guidance.o \
  sd/runtime/image_preprocess.o \
  sd/runtime/imatrix.o \
  sd/runtime/sample-cache.o \
  sd/runtime/tiling.o \
  sd/stable-diffusion.o \
  sd/tokenizers/bpe_tokenizer.o \
  sd/tokenizers/clip_tokenizer.o \
  sd/tokenizers/gemma_tokenizer.o \
  sd/tokenizers/mistral_tokenizer.o \
  sd/tokenizers/qwen2_tokenizer.o \
  sd/tokenizers/sensenova_u1_tokenizer.o \
  sd/tokenizers/t5_unigram_tokenizer.o \
  sd/tokenizers/tokenizer_config.o \
  sd/tokenizers/tokenizer.o \
  sd/tokenizers/tokenize_util.o \
  sd/tokenizers/vocab/vocab.o \
  sd/upscaler.o \
  sd/version.o

SD_OBJECTS = $(SD_CXX_OBJECTS) sd/thirdparty/zip.o

R_INTERFACE_OBJECTS = RcppExports.o sd2r_callbacks.o sd2r_params.o sd2r_ctx.o \
  sd2r_generate.o sd2r_lowlevel_bridge.o sd2r_upscale.o

OBJECTS = $(R_INTERFACE_OBJECTS) $(SD_OBJECTS)

# Force-include r_ggml_compat.h only for sd/ C++ objects (not Rcpp files).
# Rcpp files use R API directly and don't need stdio redirections.
# Use bare filename (not full path) so MinGW's quoting of paths with spaces
# (e.g. C:/Program Files/...) doesn't break -include. The header is found via
# the -I path that R adds automatically from LinkingTo: ggmlR.
# zip.c is third-party C code that doesn't use printf/abort — skip compat header
# to avoid macro conflicts with system headers (e.g. msxml.h on Windows).
# convert.o is built without the compat header on Windows (as before the
# 2026-10 upstream sync).
SD_COMPAT_FLAGS = -include r_ggml_compat.h

$(filter-out sd/convert.o,$(SD_CXX_OBJECTS)): PKG_CPPFLAGS += $(SD_COMPAT_FLAGS)
sd/version.o: PKG_CPPFLAGS += -DSDCPP_BUILD_VERSION=master_2026_10_17
