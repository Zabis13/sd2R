#!/bin/sh
# Clean compiled objects and shared library

# Recurse: sources live in src/ and several src/sd/* subdirectories, so a
# fixed list of directories goes stale whenever a new subdir is added.
find src -name '*.o'     -delete 2>/dev/null
find src -name '*.so'    -delete 2>/dev/null
find src -name '*.dll'   -delete 2>/dev/null
find src -name '*.dylib' -delete 2>/dev/null

# Remove generated files created by configure
rm -f src/Makevars
rm -f src/Makevars.win

